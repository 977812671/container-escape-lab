{
  "name": "escape-lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "remoteUser": "vscode",
  "mounts": [
    "source=/,target=/host-root,type=bind,ro",
    "source=/root,target=/vm-root-home,type=bind,ro",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "remoteEnv": {
    "ESCAPE_PROBE": "mount-injection-test"
  }
}
